# --- LLM providers: set the key for the provider you use -------------------------
Z_AI_API_KEY=            # Z.ai GLM (default provider; model glm-5.2)
ANTHROPIC_API_KEY=       # Claude (--provider anthropic, or any model named claude-*)
OPENAI_API_KEY=          # OpenAI (--provider openai, or gpt-*/o* models)
OPENROUTER_API_KEY=      # OpenRouter (--provider openrouter, or models named vendor/model)

# Local / self-hosted (no key needed):
#   ollama:            --provider ollama --model qwen2.5-coder   (OLLAMA_HOST=http://localhost:11434)
#   any OpenAI-compatible server (vLLM, LM Studio, llama.cpp):
#                      --provider openai-compat --base-url http://localhost:8000/v1
# REVCODE_BASE_URL=http://localhost:8000/v1
# REVCODE_API_KEY=

# --- Optional overrides ----------------------------------------------------------
# Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# REVCODE_HOME=~/.revcode           # sessions, universes, tuned profiles, config
# REVCODE_TIME_BUDGET_SEC=900       # wall-clock budget for headless runs
# REVCODE_NO_CACHE=1                # disable Anthropic prompt caching
# REVCODE_LLM_TIMEOUT_MS=           # raise for slow local models
# REVCODE_TRUST_PROJECT=1           # run project hooks/MCP servers without asking (CI only)
