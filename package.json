    "esbuild": "^0.28.1",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5.7",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3"
  },
  "dependencies": {
    "figlet": "^1.11.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
